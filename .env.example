# To separate your traces from other application
LANGSMITH_PROJECT=rag-research-agent

# The following depend on your selected configuration

# LLM choice:
ANTHROPIC_API_KEY=....
FIREWORKS_API_KEY=...
OPENAI_API_KEY=...

## Qwen (Alibaba Cloud DashScope, OpenAI-compatible endpoint):
##   model strings: qwen/qwen-plus (default), qwen/qwen-max, ...
QWEN_API_KEY=...

# PaperMind defaults (runtime config overrides individual top-level settings).
# Use forward slashes for Windows model paths, or a Hugging Face model ID.
PAPERMIND_RETRIEVER_PROVIDER=chroma
PAPERMIND_EMBEDDING_MODEL=BAAI/bge-m3
PAPERMIND_EMBEDDING_DEVICE=cpu
PAPERMIND_CHROMA_PATH=./chroma_db
PAPERMIND_CHROMA_COLLECTION=langchain_index
PAPERMIND_QUERY_MODEL=qwen/qwen-plus
PAPERMIND_RESPONSE_MODEL=qwen/qwen-plus
# JSON objects: retain double quotes around JSON property names.
PAPERMIND_SEARCH_KWARGS='{"k": 8}'
PAPERMIND_SPLITTER_CONFIGURATION='{"chunk_size": 512, "chunk_overlap": 64}'

# Retrieval provider

## Elastic cloud:
ELASTICSEARCH_URL=...
ELASTICSEARCH_API_KEY=...

## Elastic local:
ELASTICSEARCH_URL=http://host.docker.internal:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme

## Pinecone
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=...

## Mongo Atlas
MONGODB_URI=... # Full connection string
